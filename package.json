{
  "name": "challengelogger_server",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "packageManager": "yarn@4.4.1",
  "scripts": {
    "build": "dotenvx run -- node build.js",
    "start": "node dist/index.js",
    "dev": "dotenvx run -- nodemon --exec ts-node --files -r tsconfig-paths/register src/index.ts",
    "migration:generate": "sequelize-cli model:generate",
    "db:migrate": "dotenvx run -- sequelize db:migrate",
    "db:migrate:undo": "dotenvx run -- sequelize db:migrate:undo",
    "test": "dotenvx run -f .env.test -- jest",
    "lint": "eslint .",
    "generateSwaggerDocs": "node ./generateSwaggerDocs.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.699.0",
    "@dotenvx/dotenvx": "^1.24.5",
    "@sendgrid/mail": "^8.1.4",
    "@sentry/node": "^8.40.0",
    "@sentry/profiling-node": "^8.40.0",
    "@simplewebauthn/server": "^11.0.0",
    "cbor": "^9.0.2",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "redis": "^4.7.0",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "winston-cloudwatch": "^6.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/eslint": "^9.6.1",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "esbuild": "^0.23.1",
    "eslint": "^9.15.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "sequelize-cli": "^6.6.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
